# Qwen Cloud (OpenAI-compatible). Verified international endpoint; check your account's console if you use a different region:
#   curl -H "Authorization: Bearer $QWEN_API_KEY" $QWEN_BASE_URL/models
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_FAST=qwen-flash
QWEN_MODEL_CRITICAL=qwen3.7-max
# Hosted Corpus platform (the kit is a thin client of it)
CORPUS_BASE_URL=https://corpuslaw.us
CORPUS_API_KEY=
# Abuse/budget guard for the public demo
SPEND_CAP_TURNS_PER_HOUR=120
PORT=9000
